#!/usr/bin/env bash
# Spectra Unified CLI Dispatcher
set -e

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"

# Resolve Julia executable
if command -v julia >/dev/null 2>&1; then
    JULIA_CMD="julia"
elif [ -x "/opt/homebrew/bin/julia" ]; then
    JULIA_CMD="/opt/homebrew/bin/julia"
else
    echo "Error: Julia executable not found in PATH." >&2
    exit 1
fi

exec "$JULIA_CMD" --project="$PROJECT_ROOT" -e 'using Spectra; exit(Spectra.cli_main(ARGS))' -- "$@"

